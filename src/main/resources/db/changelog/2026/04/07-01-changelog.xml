<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-10-07-01-add-pipe-fields-to-orders" author="dev">
        <comment>Поля для труб/патрубков в заказах</comment>

        <addColumn tableName="orders">
            <column name="external_thread_id" type="BIGINT"/>
            <column name="pipe_product_kind" type="VARCHAR(20)"/>
            <column name="wall_thickness_mm" type="DOUBLE PRECISION"/>
            <column name="average_pipe_length_m" type="DOUBLE PRECISION"/>
            <column name="order_total_length_m" type="DOUBLE PRECISION"/>
            <column name="order_total_weight_kg" type="DOUBLE PRECISION"/>
            <column name="price_per_ton" type="NUMERIC(12,2)"/>
            <column name="piece_length_mm" type="DOUBLE PRECISION"/>
        </addColumn>

        <addForeignKeyConstraint
                baseColumnNames="external_thread_id"
                baseTableName="orders"
                constraintName="fk_orders_external_thread"
                referencedColumnNames="id"
                referencedTableName="external_threads_data"
                onDelete="NO ACTION"
                onUpdate="NO ACTION"/>
    </changeSet>

</databaseChangeLog>