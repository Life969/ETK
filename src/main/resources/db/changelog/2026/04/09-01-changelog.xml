<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-10-09-01-add-pipe-to-production-records" author="dev">
        <comment>
            Трубы/патрубки в журнале производства.
            Снимаем NOT NULL с coupling_id (для PIPE/NIPPLE он null).
            Добавляем pipe_product_kind и external_thread_id.
            XOR: ровно один из coupling/adapter/external_thread.
        </comment>

        <!-- Снимаем NOT NULL с coupling_id -->
        <sql>ALTER TABLE production_records ALTER COLUMN coupling_id DROP NOT NULL;</sql>

        <!-- Новые колонки -->
        <addColumn tableName="production_records">
            <column name="pipe_product_kind" type="VARCHAR(20)"/>
            <column name="external_thread_id" type="BIGINT"/>
        </addColumn>

        <!-- FK на справочник резьб -->
        <addForeignKeyConstraint
                baseColumnNames="external_thread_id"
                baseTableName="production_records"
                constraintName="fk_prod_records_external_thread"
                referencedColumnNames="id"
                referencedTableName="external_threads_data"
                onDelete="NO ACTION"
                onUpdate="NO ACTION"/>

        <!-- Пересоздаём XOR: было coupling/adapter, стало coupling/adapter/external_thread -->
        <sql>ALTER TABLE production_records DROP CONSTRAINT IF EXISTS check_product_xor;</sql>

        <sql>
            ALTER TABLE production_records
                ADD CONSTRAINT check_product_xor CHECK (
                    (coupling_id IS NOT NULL)::int
                + (adapter_id IS NOT NULL)::int
                + (external_thread_id IS NOT NULL)::int
                = 1
                );
        </sql>
    </changeSet>

</databaseChangeLog>