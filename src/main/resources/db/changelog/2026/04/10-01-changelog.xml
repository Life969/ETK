<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-10-10-01-add-piece-length-to-production-records" author="dev">
        <comment>
            Длина патрубка, мм — для журнала производства.
            Заполняется только для NIPPLE. Помогает отличать
            патрубки одного диаметра разной длины.
        </comment>

        <addColumn tableName="production_records">
            <column name="piece_length_mm" type="DOUBLE PRECISION"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>